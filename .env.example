# Configuración General del Servidor Backend
PORT=4000
NODE_ENV=development

# Ruta de la Base de Datos SQLite (en Render usar /data/carolina_sweet.db para disco persistente)
DB_PATH=./server/src/database/carolina_sweet.db

# Orígenes autorizados para CORS (separados por coma)
# En desarrollo: http://localhost:5173
# En producción: https://tu-frontend.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Control de Autenticación (false: modo taller ágil, true: exige Bearer token)
AUTH_REQUIRED=false

# URL de la API consumida por el Frontend (en Netlify/Vite)
# VITE_API_URL=https://tu-backend.onrender.com/api
